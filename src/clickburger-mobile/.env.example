# ClickBurger Mobile — Environment Variables
# Copy this file to .env.local and fill in your values

# API Base URL for backend communication
# Development (local): http://localhost:5004
# Development (device): http://192.168.X.X:5004 (use your machine's local IP)
# Production: Your Azure API URL (e.g., https://your-api.azurewebsites.net)
EXPO_PUBLIC_API_BASE_URL=http://localhost:5004
